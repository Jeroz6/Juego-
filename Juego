<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>AeroSwing 3D - Grapple Hero</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        * {
            touch-action: none;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: #020617;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        #canvas-container {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }
        
        .safe-area-layout {
            padding-bottom: max(10px, env(safe-area-inset-bottom));
            padding-top: max(8px, env(safe-area-inset-top));
            padding-left: max(14px, env(safe-area-inset-left));
            padding-right: max(14px, env(safe-area-inset-right));
        }

        .touch-btn {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1.5px solid rgba(255, 255, 255, 0.25);
            border-radius: 9999px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 800;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
            transition: transform 0.08s ease, background-color 0.1s ease, border-color 0.1s ease;
        }
        .touch-btn:active, .touch-btn.active {
            transform: scale(0.92);
            background: rgba(255, 255, 255, 0.4);
            border-color: rgba(255, 255, 255, 0.9);
        }
        .hud-glass {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .speed-lines {
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle, transparent 40%, rgba(34, 211, 238, 0.2) 100%);
            opacity: 0;
            transition: opacity 0.15s ease;
            z-index: 5;
        }
    </style>
</head>
<body class="bg-slate-950 text-white select-none">

    <div id="canvas-container"></div>
    <div id="speed-overlay" class="speed-lines"></div>

    <!-- UI Overlay Layer -->
    <div id="ui-layer" class="absolute inset-0 pointer-events-none z-10 flex flex-col justify-between safe-area-layout">
        
        <!-- Top Stats Bar & Restart Button -->
        <div class="flex justify-between items-start w-full">
            <div class="hud-glass p-2 sm:p-2.5 rounded-2xl flex flex-col gap-0.5 min-w-[120px]">
                <div class="text-[9px] uppercase tracking-widest text-cyan-400 font-bold">AeroSwing 3D</div>
                <div class="flex items-baseline gap-1">
                    <span id="speed-val" class="text-lg sm:text-xl font-black text-cyan-300">0</span>
                    <span class="text-[9px] font-bold text-slate-400">KM/H</span>
                </div>
                <div class="flex items-baseline gap-1">
                    <span id="alt-val" class="text-xs sm:text-sm font-bold text-amber-400">0</span>
                    <span class="text-[9px] text-slate-400">m ALT</span>
                </div>
            </div>

            <div class="flex gap-2 pointer-events-auto">
                <button id="btn-restart" class="hud-glass px-3 py-1.5 rounded-xl text-xs font-bold hover:bg-slate-800/80 active:scale-95 transition">
                    🔄 Reiniciar en Azotea
                </button>
            </div>
        </div>

        <!-- Jump Charge Gauge Bar -->
        <div id="charge-container" class="self-center w-40 sm:w-56 flex flex-col items-center gap-1 opacity-0 transition-opacity duration-150 -mt-2">
            <div class="text-[9px] font-black uppercase tracking-wider text-amber-300 drop-shadow">⚡ CARGANDO SALTO</div>
            <div class="w-full h-2 bg-slate-950/80 border border-amber-400/40 rounded-full p-0.5 overflow-hidden backdrop-blur-md">
                <div id="charge-bar" class="h-full w-0 bg-gradient-to-r from-cyan-400 via-amber-400 to-rose-500 rounded-full transition-all duration-75"></div>
            </div>
        </div>

        <!-- Target Lock Notification -->
        <div id="lock-notice" class="self-center hud-glass px-3 py-0.5 rounded-full text-[10px] sm:text-xs font-bold text-emerald-400 border border-emerald-500/40 opacity-0 transition-opacity duration-200">
            🎯 EDIFICIO CERCANO FIJADO
        </div>

        <!-- Touch Controls Layout for Landscape Orientation -->
        <div class="flex justify-between items-end w-full pointer-events-auto mb-1">
            
            <!-- Joystick Zone -->
            <div id="joystick-zone" class="w-28 h-28 sm:w-36 sm:h-36 relative flex items-center justify-center rounded-full bg-slate-900/40 backdrop-blur-md border border-white/20 touch-none">
                <div id="joystick-base" class="w-20 h-20 sm:w-24 sm:h-24 rounded-full border-2 border-white/20 flex items-center justify-center">
                    <div id="joystick-stick" class="w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-cyan-400/90 shadow-lg shadow-cyan-500/50 transform translate-x-0 translate-y-0 transition-transform duration-75"></div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col items-end gap-2 touch-none">
                <div class="flex gap-1.5">
                    <button id="btn-rope-short" class="touch-btn w-8 h-8 sm:w-9 sm:h-9 text-xs bg-amber-500/20 border-amber-400/30">
                        ➖
                    </button>
                    <button id="btn-rope-long" class="touch-btn w-8 h-8 sm:w-9 sm:h-9 text-xs bg-amber-500/20 border-amber-400/30">
                        ➕
                    </button>
                </div>

                <div class="flex items-end gap-2 sm:gap-2.5">
                    <!-- Sprint Button -->
                    <button id="btn-sprint" class="touch-btn w-12 h-12 sm:w-14 sm:h-14 bg-amber-500/30 border-amber-400/50 text-[9px] sm:text-[10px] font-black tracking-wider flex flex-col items-center justify-center">
                        <span>🏃</span>
                        <span>SPRINT</span>
                    </button>

                    <!-- Charge Jump Button -->
                    <button id="btn-jump" class="touch-btn w-14 h-14 sm:w-16 sm:h-16 bg-emerald-500/30 border-emerald-400/50 text-[9px] sm:text-[10px] font-black tracking-wider flex flex-col items-center justify-center">
                        <span>SALTO</span>
                        <span class="text-[7px] font-normal opacity-80">(MANTENER)</span>
                    </button>

                    <!-- Hook Button -->
                    <button id="btn-hook" class="touch-btn w-16 h-16 sm:w-20 sm:h-20 bg-cyan-500/40 border-cyan-300/70 text-xs font-black tracking-widest shadow-cyan-500/20 flex flex-col items-center justify-center">
                        <span>GANCHO</span>
                        <span class="text-[7px] font-normal opacity-80">(MANTENER)</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Start Tutorial Modal Overlay -->
    <div id="tutorial-modal" class="fixed inset-0 z-30 flex items-center justify-center p-3 bg-slate-950/90 backdrop-blur-lg">
        <div class="max-w-md w-full hud-glass p-4 sm:p-6 rounded-3xl border border-cyan-500/30 shadow-2xl text-center flex flex-col gap-3">
            <h1 class="text-xl sm:text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-blue-500">
                AEROSWING 3D
            </h1>

            <div class="bg-slate-900/80 p-3 rounded-2xl text-left text-xs text-slate-300 flex flex-col gap-1 border border-white/10">
                <div class="font-bold text-cyan-400 uppercase text-[9px] tracking-widest mb-0.5">🎮 Controles Horizontal (iPhone):</div>
                <div>• <b class="text-amber-300">🏃 SPRINT:</b> Corre rápido para tomar impulso inicial.</div>
                <div>• <b class="text-emerald-300">⚡ SALTO:</b> Mantén presionado para cargar la altura del salto.</div>
                <div>• <b class="text-cyan-300">🎯 GANCHO:</b> Se engancha al edificio <b class="text-white">MÁS CERCANO</b>.</div>
                <div>• <b class="text-white">SOLTAR GANCHO:</b> Te lanza conservando el momentum del balanceo.</div>
                <div>• <b class="text-white">CÁMARA:</b> Desliza un dedo libre en la derecha para rotar la vista.</div>
            </div>

            <button id="btn-start" class="w-full py-3 rounded-2xl font-black bg-gradient-to-r from-cyan-400 to-blue-600 text-slate-950 text-xs sm:text-sm shadow-lg shadow-cyan-500/40 transition transform active:scale-95">
                ¡EMPEZAR EN LA AZOTEA!
            </button>
        </div>
    </div>

    <script>
        class SoundEngine {
            constructor() {
                this.ctx = null;
            }
            init() {
                if (!this.ctx) {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }
            playSwing() {
                if (!this.ctx) return;
                try {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(160, this.ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(450, this.ctx.currentTime + 0.18);
                    gain.gain.setValueAtTime(0.18, this.ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.18);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start();
                    osc.stop(this.ctx.currentTime + 0.18);
                } catch(e) {}
            }
            playJump(chargeRatio = 0.5) {
                if (!this.ctx) return;
                try {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'triangle';
                    const baseFreq = 150 + chargeRatio * 300;
                    osc.frequency.setValueAtTime(baseFreq, this.ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(baseFreq * 2.2, this.ctx.currentTime + 0.18);
                    gain.gain.setValueAtTime(0.22, this.ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.18);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start();
                    osc.stop(this.ctx.currentTime + 0.18);
                } catch(e) {}
            }
            playRelease() {
                if (!this.ctx) return;
                try {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(320, this.ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(110, this.ctx.currentTime + 0.12);
                    gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.12);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start();
                    osc.stop(this.ctx.currentTime + 0.12);
                } catch(e) {}
            }
        }
        const sfx = new SoundEngine();

        let scene, camera, renderer;
        let playerMesh, ropeLine, targetMarker;
        const buildings = [];
        const attachPoints = [];

        // Game Constants & Tuning
        const GRAVITY = 25;
        const PLAYER_RADIUS = 0.65;
        const BASE_GROUND_ACCEL = 38;
        const SPRINT_GROUND_ACCEL = 75;
        const AIR_ACCEL = 5.0;
        const MIN_JUMP_IMPULSE = 11;
        const MAX_JUMP_IMPULSE = 28;
        const JUMP_CHARGE_RATE = 1.2;
        const FRICTION = 0.988;
        const GROUND_DRAG = 0.88;

        let spawnRoofPosition = new THREE.Vector3(0, 56, 0);

        // Player Motion State
        const player = {
            pos: spawnRoofPosition.clone(),
            vel: new THREE.Vector3(0, 0, 0),
            isGrounded: false,
            isSprinting: false
        };

        // Charged Jump State
        const jumpState = {
            charging: false,
            chargeTimer: 0
        };

        // Grappling Hook State
        const rope = {
            active: false,
            anchor: new THREE.Vector3(),
            length: 0,
            minLength: 3,
            maxLength: 60,
            changeSpeed: 24
        };

        let currentTarget = null;

        // Controls State
        const keys = {};
        const touchState = {
            joystick: { active: false, id: null, x: 0, y: 0 },
            camera: { active: false, id: null, lastX: 0, lastY: 0 },
            sprint: false,
            hookPressed: false,
            ropeShort: false,
            ropeLong: false
        };

        let cameraAngleX = 0;
        let cameraAngleY = 0.15;
        let baseFov = 75;

        // Helper: Validate Vector to prevent NaN freeze in Three.js
        function isVectorValid(v) {
            return !isNaN(v.x) && !isNaN(v.y) && !isNaN(v.z) && isFinite(v.x) && isFinite(v.y) && isFinite(v.z);
        }

        function initScene() {
            const container = document.getElementById('canvas-container');

            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x87ceeb);
            scene.fog = new THREE.FogExp2(0x87ceeb, 0.008);

            camera = new THREE.PerspectiveCamera(baseFov, window.innerWidth / window.innerHeight, 0.1, 500);

            renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            container.appendChild(renderer.domElement);

            // Lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.65);
            scene.add(ambientLight);

            const sunLight = new THREE.DirectionalLight(0xffffff, 0.85);
            sunLight.position.set(100, 160, 60);
            sunLight.castShadow = true;
            sunLight.shadow.mapSize.width = 1024;
            sunLight.shadow.mapSize.height = 1024;
            sunLight.shadow.camera.near = 0.5;
            sunLight.shadow.camera.far = 300;
            const d = 120;
            sunLight.shadow.camera.left = -d;
            sunLight.shadow.camera.right = d;
            sunLight.shadow.camera.top = d;
            sunLight.shadow.camera.bottom = -d;
            scene.add(sunLight);

            // Ground Plane
            const groundGeo = new THREE.PlaneGeometry(1200, 1200);
            const groundMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.95 });
            const ground = new THREE.Mesh(groundGeo, groundMat);
            ground.rotation.x = -Math.PI / 2;
            ground.receiveShadow = true;
            scene.add(ground);

            const grid = new THREE.GridHelper(1200, 120, 0x475569, 0x334155);
            grid.position.y = 0.05;
            scene.add(grid);

            // Player Hero Mesh
            const playerGeo = new THREE.SphereGeometry(PLAYER_RADIUS, 18, 18);
            const playerMat = new THREE.MeshStandardMaterial({ color: 0x06b6d4, roughness: 0.2, metalness: 0.6 });
            playerMesh = new THREE.Mesh(playerGeo, playerMat);
            playerMesh.castShadow = true;
            scene.add(playerMesh);

            // Grapple Line Visual
            const ropeGeo = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(), new THREE.Vector3()]);
            const ropeMat = new THREE.LineBasicMaterial({ color: 0x22d3ee, linewidth: 3 });
            ropeLine = new THREE.Line(ropeGeo, ropeMat);
            ropeLine.visible = false;
            scene.add(ropeLine);

            // Target Anchor Reticle
            const targetGeo = new THREE.RingGeometry(0.7, 1.1, 18);
            const targetMat = new THREE.MeshBasicMaterial({ color: 0x10b981, side: THREE.DoubleSide, transparent: true, opacity: 0.9 });
            targetMarker = new THREE.Mesh(targetGeo, targetMat);
            targetMarker.visible = false;
            scene.add(targetMarker);

            generateCity();

            window.addEventListener('resize', onWindowResize);
        }

        function generateCity() {
            const buildingColors = [0x1e293b, 0x334155, 0x475569, 0x0f172a, 0x1e3a8a, 0x111827];
            const spacing = 32;

            // Spawn Skyscraper at Center (0, 0)
            const spawnHeight = 55;
            const spawnWidth = 24;
            const spawnGeo = new THREE.BoxGeometry(spawnWidth, spawnHeight, spawnWidth);
            const spawnMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.4 });
            const spawnBuilding = new THREE.Mesh(spawnGeo, spawnMat);
            spawnBuilding.position.set(0, spawnHeight / 2, 0);
            spawnBuilding.castShadow = true;
            spawnBuilding.receiveShadow = true;
            scene.add(spawnBuilding);

            buildings.push({
                box: new THREE.Box3(
                    new THREE.Vector3(-spawnWidth / 2, 0, -spawnWidth / 2),
                    new THREE.Vector3(spawnWidth / 2, spawnHeight, spawnWidth / 2)
                ),
                height: spawnHeight
            });

            // Set player initial spawn position securely on top of spawn roof
            spawnRoofPosition.set(0, spawnHeight + PLAYER_RADIUS + 0.1, 0);
            player.pos.copy(spawnRoofPosition);

            // Generate surrounding city buildings
            for (let x = -8; x <= 8; x++) {
                for (let z = -12; z <= 12; z++) {
                    if (x === 0 && z === 0) continue;

                    const posX = x * spacing + (Math.random() - 0.5) * 6;
                    const posZ = z * spacing + (Math.random() - 0.5) * 6;
                    const height = 30 + Math.random() * 55;
                    const bWidth = 12 + Math.random() * 8;
                    const bDepth = 12 + Math.random() * 8;

                    const geo = new THREE.BoxGeometry(bWidth, height, bDepth);
                    const color = buildingColors[Math.floor(Math.random() * buildingColors.length)];
                    const mat = new THREE.MeshStandardMaterial({ color: color, roughness: 0.5 });
                    const building = new THREE.Mesh(geo, mat);

                    building.position.set(posX, height / 2, posZ);
                    building.castShadow = true;
                    building.receiveShadow = true;
                    scene.add(building);

                    buildings.push({
                        box: new THREE.Box3(
                            new THREE.Vector3(posX - bWidth / 2, 0, posZ - bDepth / 2),
                            new THREE.Vector3(posX + bWidth / 2, height, posZ + bDepth / 2)
                        ),
                        height: height
                    });

                    const halfW = bWidth / 2;
                    const halfD = bDepth / 2;
                    const topY = height;

                    attachPoints.push(
                        new THREE.Vector3(posX - halfW, topY, posZ - halfD),
                        new THREE.Vector3(posX + halfW, topY, posZ - halfD),
                        new THREE.Vector3(posX - halfW, topY, posZ + halfD),
                        new THREE.Vector3(posX + halfW, topY, posZ + halfD),
                        new THREE.Vector3(posX, topY, posZ)
                    );
                }
            }
        }

        function updateTargetLock() {
            let bestPoint = null;
            let bestScore = Infinity;

            const camDir = new THREE.Vector3();
            camera.getWorldDirection(camDir);

            attachPoints.forEach(pt => {
                const dist = player.pos.distanceTo(pt);
                if (dist > 3 && dist < rope.maxLength) {
                    const dirToPt = pt.clone().sub(player.pos).normalize();
                    const angle = camDir.angleTo(dirToPt);

                    if (angle < Math.PI / 2.8) {
                        const score = (dist * dist * 0.8) * (1 + angle * 3.0);
                        if (score < bestScore) {
                            bestScore = score;
                            bestPoint = pt;
                        }
                    }
                }
            });

            currentTarget = bestPoint;

            const notice = document.getElementById('lock-notice');
            if (currentTarget && !rope.active) {
                targetMarker.position.copy(currentTarget);
                targetMarker.lookAt(player.pos);
                targetMarker.visible = true;
                notice.style.opacity = '1';
            } else if (!rope.active) {
                targetMarker.visible = false;
                notice.style.opacity = '0';
            }
        }

        function setupControls() {
            document.addEventListener('gesturestart', (e) => e.preventDefault());
            document.addEventListener('touchmove', (e) => {
                if (e.scale !== 1) e.preventDefault();
            }, { passive: false });

            // Keyboard Controls
            window.addEventListener('keydown', (e) => {
                keys[e.code] = true;
                if (e.code === 'KeyE') startHook();
                if (e.code === 'Space' && !e.repeat) startJumpCharge();
            });
            window.addEventListener('keyup', (e) => {
                keys[e.code] = false;
                if (e.code === 'KeyE') stopHook();
                if (e.code === 'Space') releaseJump();
            });

            // UI Modal Handlers
            document.getElementById('btn-start').addEventListener('click', () => {
                sfx.init();
                document.getElementById('tutorial-modal').style.display = 'none';
            });

            document.getElementById('btn-restart').addEventListener('click', () => {
                player.pos.copy(spawnRoofPosition);
                player.vel.set(0, 0, 0);
                stopHook();
            });

            // Touch Action Buttons
            const bindButtonTouch = (btn, onStart, onEnd) => {
                const handleStart = (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    btn.classList.add('active');
                    onStart();
                };
                const handleEnd = (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    btn.classList.remove('active');
                    onEnd();
                };

                btn.addEventListener('touchstart', handleStart, { passive: false });
                btn.addEventListener('touchend', handleEnd, { passive: false });
                btn.addEventListener('touchcancel', handleEnd, { passive: false });
            };

            bindButtonTouch(
                document.getElementById('btn-sprint'),
                () => { touchState.sprint = true; },
                () => { touchState.sprint = false; }
            );

            bindButtonTouch(
                document.getElementById('btn-hook'),
                () => { touchState.hookPressed = true; startHook(); },
                () => { touchState.hookPressed = false; stopHook(); }
            );

            bindButtonTouch(
                document.getElementById('btn-jump'),
                () => { startJumpCharge(); },
                () => { releaseJump(); }
            );

            bindButtonTouch(
                document.getElementById('btn-rope-short'),
                () => { touchState.ropeShort = true; },
                () => { touchState.ropeShort = false; }
            );

            bindButtonTouch(
                document.getElementById('btn-rope-long'),
                () => { touchState.ropeLong = true; },
                () => { touchState.ropeLong = false; }
            );

            // Multi-Touch Joystick & Camera Drag Pan
            const joystickZone = document.getElementById('joystick-zone');
            const joystickStick = document.getElementById('joystick-stick');

            window.addEventListener('touchstart', (e) => {
                for (let i = 0; i < e.changedTouches.length; i++) {
                    const touch = e.changedTouches[i];
                    const target = touch.target;

                    if (joystickZone.contains(target) && !touchState.joystick.active) {
                        touchState.joystick.active = true;
                        touchState.joystick.id = touch.identifier;
                        updateJoystickPos(touch);
                    } 
                    else if (touch.clientX > window.innerWidth * 0.35 && !touchState.camera.active) {
                        if (!target.closest('.touch-btn') && !target.closest('#btn-restart')) {
                            touchState.camera.active = true;
                            touchState.camera.id = touch.identifier;
                            touchState.camera.lastX = touch.clientX;
                            touchState.camera.lastY = touch.clientY;
                        }
                    }
                }
            }, { passive: false });

            window.addEventListener('touchmove', (e) => {
                for (let i = 0; i < e.touches.length; i++) {
                    const touch = e.touches[i];

                    if (touchState.joystick.active && touch.identifier === touchState.joystick.id) {
                        updateJoystickPos(touch);
                    }
                    if (touchState.camera.active && touch.identifier === touchState.camera.id) {
                        const dx = touch.clientX - touchState.camera.lastX;
                        const dy = touch.clientY - touchState.camera.lastY;

                        cameraAngleX -= dx * 0.005;
                        cameraAngleY = Math.max(-Math.PI / 3, Math.min(Math.PI / 3, cameraAngleY + dy * 0.005));

                        touchState.camera.lastX = touch.clientX;
                        touchState.camera.lastY = touch.clientY;
                    }
                }
            }, { passive: false });

            const handleTouchEnd = (e) => {
                for (let i = 0; i < e.changedTouches.length; i++) {
                    const touch = e.changedTouches[i];
                    if (touchState.joystick.active && touch.identifier === touchState.joystick.id) {
                        touchState.joystick.active = false;
                        touchState.joystick.id = null;
                        touchState.joystick.x = 0;
                        touchState.joystick.y = 0;
                        joystickStick.style.transform = 'translate(0px, 0px)';
                    }
                    if (touchState.camera.active && touch.identifier === touchState.camera.id) {
                        touchState.camera.active = false;
                        touchState.camera.id = null;
                    }
                }
            };

            window.addEventListener('touchend', handleTouchEnd);
            window.addEventListener('touchcancel', handleTouchEnd);

            function updateJoystickPos(touch) {
                const rect = joystickZone.getBoundingClientRect();
                const centerX = rect.left + rect.width / 2;
                const centerY = rect.top + rect.height / 2;

                let dx = touch.clientX - centerX;
                let dy = touch.clientY - centerY;
                const maxDist = rect.width / 2 - 8;

                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dist > maxDist) {
                    dx = (dx / dist) * maxDist;
                    dy = (dy / dist) * maxDist;
                }

                joystickStick.style.transform = `translate(${dx}px, ${dy}px)`;
                touchState.joystick.x = dx / maxDist;
                touchState.joystick.y = dy / maxDist;
            }

            // Mouse Drag Controls for Desktop Testing
            let isMouseDragging = false;
            window.addEventListener('mousedown', (e) => {
                if (e.clientX > window.innerWidth * 0.35) isMouseDragging = true;
            });
            window.addEventListener('mouseup', () => isMouseDragging = false);
            window.addEventListener('mousemove', (e) => {
                if (isMouseDragging) {
                    cameraAngleX -= e.movementX * 0.003;
                    cameraAngleY = Math.max(-Math.PI / 3, Math.min(Math.PI / 3, cameraAngleY + e.movementY * 0.003));
                }
            });
        }

        function startHook() {
            if (currentTarget && !rope.active) {
                rope.active = true;
                rope.anchor.copy(currentTarget);
                rope.length = Math.max(3.0, player.pos.distanceTo(rope.anchor));
                ropeLine.visible = true;
                targetMarker.visible = false;
                sfx.playSwing();
            }
        }

        function stopHook() {
            if (rope.active) {
                rope.active = false;
                ropeLine.visible = false;
                sfx.playRelease();
            }
        }

        function startJumpCharge() {
            if (player.isGrounded || rope.active) {
                jumpState.charging = true;
                jumpState.chargeTimer = 0;
            }
        }

        function releaseJump() {
            if (jumpState.charging) {
                jumpState.charging = false;

                const chargeRatio = Math.min(1.0, jumpState.chargeTimer / JUMP_CHARGE_RATE);
                const sprintMult = player.isSprinting ? 1.25 : 1.0;
                const jumpForce = (MIN_JUMP_IMPULSE + chargeRatio * (MAX_JUMP_IMPULSE - MIN_JUMP_IMPULSE)) * sprintMult;

                if (player.isGrounded) {
                    player.vel.y = jumpForce;
                    player.isGrounded = false;
                    sfx.playJump(chargeRatio);
                } else if (rope.active) {
                    stopHook();
                    player.vel.y += jumpForce * 0.85;
                    sfx.playJump(chargeRatio);
                }

                jumpState.chargeTimer = 0;
            }
        }

        function updatePhysics(dt) {
            // Strictly clamp delta-time to prevent physics instability or extreme frame jumps
            dt = Math.min(dt, 0.033);
            if (dt <= 0) return;

            // 1. Sprint State
            player.isSprinting = keys['ShiftLeft'] || keys['ShiftRight'] || touchState.sprint;

            const speedOverlay = document.getElementById('speed-overlay');
            const currentSpeed = player.vel.length();
            if (player.isSprinting && currentSpeed > 10) {
                speedOverlay.style.opacity = '1';
                camera.fov = THREE.MathUtils.lerp(camera.fov, baseFov + 12, 0.1);
            } else {
                speedOverlay.style.opacity = '0';
                camera.fov = THREE.MathUtils.lerp(camera.fov, baseFov, 0.1);
            }
            camera.updateProjectionMatrix();

            // 2. Jump Charge Gauge Update
            const chargeContainer = document.getElementById('charge-container');
            const chargeBar = document.getElementById('charge-bar');

            if (jumpState.charging) {
                jumpState.chargeTimer += dt;
                const ratio = Math.min(1.0, jumpState.chargeTimer / JUMP_CHARGE_RATE);
                chargeContainer.style.opacity = '1';
                chargeBar.style.width = `${ratio * 100}%`;
            } else {
                chargeContainer.style.opacity = '0';
            }

            // 3. Directional Movement Inputs
            let moveX = 0;
            let moveZ = 0;

            if (keys['KeyW'] || keys['ArrowUp']) moveZ -= 1;
            if (keys['KeyS'] || keys['ArrowDown']) moveZ += 1;
            if (keys['KeyA'] || keys['ArrowLeft']) moveX -= 1;
            if (keys['KeyD'] || keys['ArrowRight']) moveX += 1;

            if (touchState.joystick.active) {
                moveX = touchState.joystick.x;
                moveZ = touchState.joystick.y;
            }

            const forward = new THREE.Vector3(-Math.sin(cameraAngleX), 0, -Math.cos(cameraAngleX)).normalize();
            const right = new THREE.Vector3(Math.cos(cameraAngleX), 0, -Math.sin(cameraAngleX)).normalize();

            const moveDir = new THREE.Vector3()
                .addScaledVector(forward, -moveZ)
                .addScaledVector(right, moveX);

            if (moveDir.lengthSq() > 1) moveDir.normalize();

            // 4. Ground vs Air Movement Acceleration
            if (player.isGrounded) {
                const accel = player.isSprinting ? SPRINT_GROUND_ACCEL : BASE_GROUND_ACCEL;
                player.vel.x += moveDir.x * accel * dt;
                player.vel.z += moveDir.z * accel * dt;
                player.vel.x *= GROUND_DRAG;
                player.vel.z *= GROUND_DRAG;
            } else {
                player.vel.x += moveDir.x * AIR_ACCEL * dt;
                player.vel.z += moveDir.z * AIR_ACCEL * dt;
                player.vel.x *= FRICTION;
                player.vel.z *= FRICTION;
            }

            // 5. Apply Gravity
            player.vel.y -= GRAVITY * dt;

            // 6. Adjust Rope Length
            if (rope.active) {
                if (keys['KeyQ'] || touchState.ropeShort) {
                    rope.length = Math.max(rope.minLength, rope.length - rope.changeSpeed * dt);
                }
                if (touchState.ropeLong) {
                    rope.length = Math.min(rope.maxLength, rope.length + rope.changeSpeed * dt);
                }
            }

            // 7. Integrate Position
            player.pos.addScaledVector(player.vel, dt);

            // 8. STABLE PENDULUM CONSTRAINT (Fixes Safari Freezing/NaN glitches)
            if (rope.active) {
                const safeRopeLength = Math.max(2.0, rope.length);
                const toAnchor = player.pos.clone().sub(rope.anchor);
                const currentDist = toAnchor.length();

                if (currentDist > safeRopeLength && currentDist > 0.0001) {
                    const ropeDir = toAnchor.normalize(); // Normalized vector pointing from Anchor to Player
                    
                    // Pull position back onto boundary of rope length sphere
                    player.pos.copy(rope.anchor).addScaledVector(ropeDir, safeRopeLength);

                    // Remove outward radial velocity along rope direction vector
                    const vRadial = player.vel.dot(ropeDir);
                    if (vRadial > 0) {
                        player.vel.subScaledVector(ropeDir, vRadial);
                    }
                }
            }

            // Fallback Guard: Reset invalid vectors if numeric anomaly occurs
            if (!isVectorValid(player.pos) || !isVectorValid(player.vel)) {
                player.pos.copy(spawnRoofPosition);
                player.vel.set(0, 0, 0);
                stopHook();
            }

            // 9. Rooftop & Building Wall Collisions
            let hitGroundOrRoof = false;

            if (player.pos.y - PLAYER_RADIUS <= 0) {
                player.pos.y = PLAYER_RADIUS;
                player.vel.y = 0;
                hitGroundOrRoof = true;
            }

            buildings.forEach(b => {
                const box = b.box;
                if (
                    player.pos.x + PLAYER_RADIUS >= box.min.x && player.pos.x - PLAYER_RADIUS <= box.max.x &&
                    player.pos.z + PLAYER_RADIUS >= box.min.z && player.pos.z - PLAYER_RADIUS <= box.max.z &&
                    player.pos.y + PLAYER_RADIUS >= box.min.y && player.pos.y - PLAYER_RADIUS <= box.max.y
                ) {
                    const overlapY = box.max.y - (player.pos.y - PLAYER_RADIUS);

                    // Landing on roof top surface cleanly
                    if (overlapY > 0 && overlapY < 3.0 && player.vel.y <= 0) {
                        player.pos.y = box.max.y + PLAYER_RADIUS;
                        player.vel.y = 0;
                        hitGroundOrRoof = true;
                    } else {
                        // Push out from side walls
                        const dxMin = Math.abs((player.pos.x + PLAYER_RADIUS) - box.min.x);
                        const dxMax = Math.abs((player.pos.x - PLAYER_RADIUS) - box.max.x);
                        const dzMin = Math.abs((player.pos.z + PLAYER_RADIUS) - box.min.z);
                        const dzMax = Math.abs((player.pos.z - PLAYER_RADIUS) - box.max.y);

                        const minOverlap = Math.min(dxMin, dxMax, dzMin, dzMax);

                        if (minOverlap === dxMin) { player.pos.x = box.min.x - PLAYER_RADIUS; player.vel.x *= -0.2; }
                        else if (minOverlap === dxMax) { player.pos.x = box.max.x + PLAYER_RADIUS; player.vel.x *= -0.2; }
                        else if (minOverlap === dzMin) { player.pos.z = box.min.z - PLAYER_RADIUS; player.vel.z *= -0.2; }
                        else if (minOverlap === dzMax) { player.pos.z = box.max.z + PLAYER_RADIUS; player.vel.z *= -0.2; }
                    }
                }
            });

            player.isGrounded = hitGroundOrRoof;
            playerMesh.position.copy(player.pos);

            // Update Line Buffer for Rope Visualization
            if (rope.active) {
                const posArr = ropeLine.geometry.attributes.position.array;
                posArr[0] = player.pos.x;
                posArr[1] = player.pos.y;
                posArr[2] = player.pos.z;
                posArr[3] = rope.anchor.x;
                posArr[4] = rope.anchor.y;
                posArr[5] = rope.anchor.z;
                ropeLine.geometry.attributes.position.needsUpdate = true;
            }
        }

        function updateCamera() {
            const camDist = 12;
            const targetCamPos = new THREE.Vector3(
                player.pos.x + Math.sin(cameraAngleX) * camDist * Math.cos(cameraAngleY),
                player.pos.y + Math.sin(cameraAngleY) * camDist + 3,
                player.pos.z + Math.cos(cameraAngleX) * camDist * Math.cos(cameraAngleY)
            );

            camera.position.lerp(targetCamPos, 0.12);
            camera.lookAt(player.pos.x, player.pos.y + 1, player.pos.z);
        }

        function updateHUD() {
            const speed = Math.round(player.vel.length() * 3.6);
            const alt = Math.max(0, Math.round(player.pos.y - PLAYER_RADIUS));

            document.getElementById('speed-val').innerText = speed;
            document.getElementById('alt-val').innerText = alt;
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        let lastTime = performance.now();
        function animate() {
            requestAnimationFrame(animate);

            const now = performance.now();
            const dt = (now - lastTime) / 1000;
            lastTime = now;

            updatePhysics(dt);
            updateTargetLock();
            updateCamera();
            updateHUD();

            renderer.render(scene, camera);
        }

        window.onload = () => {
            initScene();
            setupControls();
            animate();
        };
    </script>
</body>
</html>
